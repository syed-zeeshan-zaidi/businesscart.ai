# Copy to scripts/.precommit.env (gitignored) and fill in, so pre-push can run
# the storefront validator + e2e. Never commit the real file.
#
#   cp scripts/.precommit.env.example scripts/.precommit.env
#
ADMIN_PASSWORD=
# Stripe SANDBOX secret key (sk_test_...) — required to run the storefront e2e.
# Never a live sk_live_ key. This file is gitignored; never commit the real key.
STRIPE_TEST_SECRET_KEY=
