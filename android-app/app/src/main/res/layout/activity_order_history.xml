<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.checkout.OrderHistoryActivity">

    <!-- ===================================================================== -->
    <!-- 1. Status-bar fill (same height/color as AccountActivity)            -->
    <!-- ===================================================================== -->
    <View
        android:id="@+id/statusBarFill"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===================================================================== -->
    <!-- 2. Title (identical typography & margins to AccountActivity)          -->
    <!-- ===================================================================== -->
    <TextView
        android:id="@+id/orderHistoryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="16dp"
        android:text="Order History"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===================================================================== -->
    <!-- 3. RecyclerView (fills remaining space)                               -->
    <!-- ===================================================================== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ordersRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/orderHistoryTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_order" />

    <!-- ===================================================================== -->
    <!-- 4. Empty-state label (optional – shown when list is empty)            -->
    <!-- ===================================================================== -->
    <TextView
        android:id="@+id/emptyOrdersText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No orders yet"
        android:textSize="16sp"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/ordersRecyclerView"
        app:layout_constraintBottom_toBottomOf="@id/ordersRecyclerView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===================================================================== -->
    <!-- 5. Progress indicator                                                 -->
    <!-- ===================================================================== -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>